// Shared settings for all targets. Secrets are optional so forks/CI build without them.
#include? "Secrets.xcconfig"
SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
IPHONEOS_DEPLOYMENT_TARGET = 17.0
MACOSX_DEPLOYMENT_TARGET = 14.0
TVOS_DEPLOYMENT_TARGET = 17.0
// Versions are inherited from the Xcode project's build settings.
ENABLE_USER_SCRIPT_SANDBOXING = YES
DEVELOPMENT_TEAM = $(SMARTTUBE_TEAM_ID)
